{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/WorkingWithQuantity","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"metadata":{"modules":[{"name":"Math"}],"roleHeading":"Article","title":"Working with Quantity","role":"article"},"abstract":[{"type":"text","text":"Create, convert, compare, compute with, and format "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","isActive":true,"type":"reference"},{"type":"text","text":" values in your app."}],"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/Math\/documentation\/Math\/GettingStarted","doc:\/\/Math\/documentation\/Math\/StoringAndEncodingQuantities","doc:\/\/Math\/documentation\/Math\/UnitsByDimension","doc:\/\/Math\/documentation\/Math\/Quantity"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity"},{"text":" is the type you’ll reach for most often. It works the way","type":"text"},{"text":" ","type":"text"},{"text":"Foundation’s ","type":"text"},{"code":"Measurement","type":"codeVoice"},{"text":" does, but with compile-time dimension checking: a","type":"text"},{"text":" ","type":"text"},{"text":"quantity always knows its unit, and its unit knows its ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This article covers everything you can do with a quantity, grouped the same way","type":"text"},{"text":" ","type":"text"},{"text":"Apple documents its own value types.","type":"text"}]},{"text":"Create a Quantity","type":"heading","anchor":"Create-a-Quantity","level":3},{"type":"paragraph","inlineContent":[{"text":"Create a quantity with a value and a unit using","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/init(value:unit:)","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"code":["import Math","","\/\/ Distance","let jumpLength = Quantity(value: 8.95, unit: Units.meter)","","\/\/ Money — currency units place their symbol before the value ($8.95)","let price = Quantity(value: 8.95, unit: Units.usd)","","\/\/ Temperature — offset units like Celsius convert correctly","let bodyTemp = Quantity(value: 37.0, unit: Units.celsius)"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The value is a "},{"type":"codeVoice","code":"Decimal"},{"type":"text","text":", so you can pass integer and decimal literals"},{"type":"text","text":" "},{"type":"text","text":"directly: "},{"type":"codeVoice","code":"Quantity(value: 42, unit: Units.kilometer)"},{"type":"text","text":". Decimal arithmetic"},{"type":"text","text":" "},{"type":"text","text":"keeps base-10 values exact—"},{"type":"codeVoice","code":"0.1 + 0.2"},{"type":"text","text":" really is "},{"code":"0.3","type":"codeVoice"},{"type":"text","text":"—which matters for"},{"type":"text","text":" "},{"type":"text","text":"money, scientific constants, and repeated conversions."}],"type":"paragraph"}]},{"text":"Convert Between Units","anchor":"Convert-Between-Units","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/converted(to:)","isActive":true},{"type":"text","text":" to convert to another unit of the "},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"dimension. The framework converts through the unit’s base unit, so arbitrary"},{"type":"text","text":" "},{"type":"text","text":"chains like "},{"code":"nanometer → kilometer","type":"codeVoice"},{"type":"text","text":" just work:"}]},{"code":["let chipFeature = Quantity(value: 5.0, unit: Units.nanometer)","let inMeters = chipFeature.converted(to: Units.meter)","print(inMeters.value) \/\/ 5e-09","","let marathon = Quantity(value: 42.195, unit: Units.kilometer)","print(marathon.converted(to: Units.mile).value) \/\/ 26.218...","","let paycheck = Quantity(value: 100.0, unit: Units.eur)","print(paycheck.converted(to: Units.usd).value) \/\/ 108.0"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because conversions require matching dimensions, converting a "},{"code":"length","type":"codeVoice"},{"type":"text","text":" to a"},{"type":"text","text":" "},{"code":"time","type":"codeVoice"},{"type":"text","text":" doesn’t compile (or traps at runtime if the units are fully dynamic)."},{"type":"text","text":" "},{"type":"text","text":"See "},{"identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","isActive":true,"type":"reference"},{"type":"text","text":" for details."}]},{"text":"Compare Quantities","anchor":"Compare-Quantities","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Quantities of the same unit type compare by their values with ","type":"text"},{"type":"codeVoice","code":"=="},{"text":". To compare","type":"text"},{"text":" ","type":"text"},{"text":"quantities expressed in ","type":"text"},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"text":" units of the same dimension—or to allow a","type":"text"},{"text":" ","type":"text"},{"text":"small tolerance—use ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/isEquivalent(to:tolerance:)","type":"reference","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let oneMile = Quantity(value: 1.0, unit: Units.mile)","let oneKm    = Quantity(value: 1.0, unit: Units.kilometer)","","oneMile.isEquivalent(to: Quantity(value: 1609.344, unit: Units.meter)) \/\/ true","oneMile.isEquivalent(to: oneKm)                                        \/\/ false"]},{"type":"heading","level":3,"anchor":"Add-and-Subtract-Quantities","text":"Add and Subtract Quantities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can add and subtract quantities of the same dimension even when their units"},{"type":"text","text":" "},{"type":"text","text":"differ. The result keeps the left-hand side’s unit; the right-hand side is"},{"type":"text","text":" "},{"type":"text","text":"converted automatically:"}]},{"type":"codeListing","syntax":"swift","code":["let dish = Quantity(value: 1.5, unit: Units.kilogram)","let spice = Quantity(value: 350.0, unit: Units.gram)","","let total = dish + spice","print(total) \/\/ 1.85 kg"]},{"type":"heading","level":3,"anchor":"Multiply-and-Divide-Quantities","text":"Multiply and Divide Quantities"},{"type":"paragraph","inlineContent":[{"text":"Multiplying or dividing two quantities combines their dimensions. Multiplication","type":"text"},{"text":" ","type":"text"},{"text":"produces a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompositeUnit"},{"text":"; division produces a typed ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/RatioUnit"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"remembers which operand was on top. The framework adjusts both the numeric value","type":"text"},{"text":" ","type":"text"},{"text":"and the coefficient so results stay physically correct:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let area = Quantity(value: 3.0, unit: Units.meter) * Quantity(value: 2.0, unit: Units.meter)","print(area.value)          \/\/ 6.0","print(area.unit.symbol)    \/\/ \"(m*m)\"","print(area.unit.dimension) \/\/ area","","let speed = Quantity(value: 100.0, unit: Units.meter) \/ Quantity(value: 5.0, unit: Units.second)","print(speed.value)          \/\/ 20.0","print(speed.unit.symbol)    \/\/ \"(m\/s)\"","print(speed.unit.dimension) \/\/ speed"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also multiply and divide a quantity by a plain "},{"code":"Decimal","type":"codeVoice"},{"type":"text","text":" scalar, which"},{"text":" ","type":"text"},{"text":"keeps the same unit:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let doubling = Quantity(value: 5.0, unit: Units.meter) * 2","print(doubling) \/\/ 10.00 m"]},{"type":"paragraph","inlineContent":[{"text":"For common derived dimensions, ","type":"text"},{"code":"Math","type":"codeVoice"},{"text":" produces cleaner units. For example,","type":"text"},{"text":" ","type":"text"},{"text":"multiplying a ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/power","type":"reference","isActive":true},{"text":" by a ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","type":"reference","isActive":true},{"text":" yields an","type":"text"},{"text":" ","type":"text"},{"text":"energy unit with the conventional symbol ordering:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let power   = Quantity(value: 2.0, unit: Units.kilowatt)","let runTime = Quantity(value: 3.0, unit: Units.hour)","let energy  = power * runTime    \/\/ 6 kWh, dimension = energy"]},{"type":"heading","level":3,"anchor":"Typed-Ratio-Units","text":"Typed Ratio Units"},{"type":"paragraph","inlineContent":[{"text":"Sometimes you don’t just want a measurement — you want the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"type system"}]},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"remember which side of a ratio something is on. A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/CompositeUnit"},{"text":" like","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"(usd\/kg)"},{"text":" erases that detail (its compile-time dimension is always","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"unknown"},{"text":"), so ","type":"text"},{"type":"codeVoice","code":"USD per kilogram"},{"text":" and ","type":"text"},{"code":"kilogram per USD","type":"codeVoice"},{"type":"text","text":" become the same type."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/RatioUnit","isActive":true},{"type":"text","text":" keeps the numerator and denominator as two distinct generic"},{"type":"text","text":" "},{"type":"text","text":"parameters, so "},{"type":"codeVoice","code":"USD \/ kg"},{"type":"text","text":" is a "},{"type":"emphasis","inlineContent":[{"text":"different type","type":"text"}]},{"type":"text","text":" from "},{"type":"codeVoice","code":"kg \/ USD"},{"type":"text","text":". Build one with"},{"type":"text","text":" "},{"type":"text","text":"``MathUnit\/per(_:)`, the initializer, or just divide two quantities:"}]},{"code":["let price = Units.usd.per(Units.kilogram)            \/\/ (usd\/kg)","let hoursPerDollar = Units.hour.per(Units.usd)       \/\/ (h\/$)","let fromDivision = Quantity(value: 40, unit: Units.usd)","                \/ Quantity(value: 5, unit: Units.Weight.pound)  \/\/ ($\/lbf)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Because the ordering is baked into the type, a generic function can require a","type":"text"},{"text":" ","type":"text"},{"text":"specific arrangement. Here the denominator must ","type":"text"},{"inlineContent":[{"text":"be","type":"text"}],"type":"emphasis"},{"text":" a currency unit:","type":"text"}]},{"code":["func denominatedInCurrency<Num: MathUnit>(","    _ value: Quantity<RatioUnit<Num, NamedUnit<MathDimension.currency>>>",") -> Bool { ... }","","denominatedInCurrency(Quantity(value: 2, unit: Units.hour.per(Units.usd)))  \/\/ ✔","denominatedInCurrency(Quantity(value: 20, unit: Units.usd.per(Units.hour))) \/\/ ✘ won't compile"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiplying a ratio by its denominator cancels the denominator and returns the"},{"type":"text","text":" "},{"type":"text","text":"numerator: "},{"code":"price * amount → money","type":"codeVoice"},{"type":"text","text":". Both operand orders work, and the"},{"type":"text","text":" "},{"type":"text","text":"math always runs through base units so coefficients stay exact:"}]},{"code":["let cost = Quantity(value: 3.5, unit: Units.usd.per(Units.kilogram))","         * Quantity(value: 2, unit: Units.kilogram)   \/\/ $7.00"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Format Quantities","anchor":"Format-Quantities"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","type":"reference","isActive":true},{"type":"text","text":" conforms to "},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":", so it prints a formatted","type":"text"},{"text":" ","type":"text"},{"text":"string automatically. Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/formatted(decimalPlaces:includeSpace:)","type":"reference"},{"text":" ","type":"text"},{"text":"to control the decimal places and spacing. Currency symbols are placed before","type":"text"},{"text":" ","type":"text"},{"text":"the value by default; most other symbols follow it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let tenDollars = Quantity(value: 10.1234, unit: Units.usd)","print(tenDollars.formatted())                 \/\/ \"$10.12\"","print(tenDollars.formatted(decimalPlaces: 3)) \/\/ \"$10.123\"","","let fiveMeters = Quantity(value: 5.5, unit: Units.meter)","print(fiveMeters.formatted())                 \/\/ \"5.50 m\"","print(fiveMeters.formatted(includeSpace: false)) \/\/ \"5.50m\"","","let percent = Quantity(value: 75.5, unit: Units.percent)","print(percent.formatted())                    \/\/ \"75.50%\""]},{"text":"Store Mixed Dimensions with `AnyQuantity`","anchor":"Store-Mixed-Dimensions-with-AnyQuantity","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","isActive":true,"type":"reference"},{"text":"‘s unit type is part of its Swift type, so a single array cannot","type":"text"},{"text":" ","type":"text"},{"text":"hold a length, a mass, and a count of tea bags. ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/AnyQuantity","isActive":true,"type":"reference"},{"text":" erases that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"compile-time dimension while preserving the unit’s runtime behavior:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let ingredients: [AnyQuantity] = [","    AnyQuantity(value: 250, unit: Units.gram),","    AnyQuantity(value: 8, unit: Units.fluidOunce),","    AnyQuantity(value: 2, unit: CountUnit(item: \"tea bag\")),","]","","for ingredient in ingredients {","    print(ingredient.simplified()) \/\/ 250.00 g, 8.00 fl oz, 2.00 tea bag","}"]},{"inlineContent":[{"code":"AnyQuantity","type":"codeVoice"},{"type":"text","text":" converts (returning either a typed "},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","type":"reference"},{"type":"text","text":" or another erased"},{"type":"text","text":" "},{"type":"text","text":"quantity), simplifies, formats, compares for physical equivalence, and supports"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"code":"+","type":"codeVoice"},{"type":"text","text":", "},{"code":"-","type":"codeVoice"},{"type":"text","text":", "},{"code":"*","type":"codeVoice"},{"type":"text","text":", and "},{"code":"\/","type":"codeVoice"},{"type":"text","text":" operators as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity"},{"type":"text","text":". Compatibility is"},{"type":"text","text":" "},{"type":"text","text":"checked at runtime, so adding a mass to a length traps instead of compiling"},{"type":"text","text":" "},{"type":"text","text":"silently."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"An erased quantity is also ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":". Its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/AnyMathUnit"},{"text":" records the symbol,","type":"text"},{"text":" ","type":"text"},{"text":"dimension, converter, symbol position, identity, and conversion family, so a","type":"text"},{"text":" ","type":"text"},{"text":"JSON round trip restores a fully functional unit:","type":"text"}]},{"syntax":"swift","code":["let data = try JSONEncoder().encode(ingredients)","let decoded = try JSONDecoder().decode([AnyQuantity].self, from: data)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To restore a statically typed value when you know the unit type, use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/AnyQuantity\/typed(as:)"},{"type":"text","text":". You can also erase any typed quantity with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/anyQuantity"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"For units alone, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/AnyMathUnit","type":"reference"},{"text":"; for runtime dimensions, use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/AnyDimension","type":"reference"},{"text":". Both are ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", and "},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Whats-Next","type":"heading","level":3,"text":"What’s Next?"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Browse the ready-made units in "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units","type":"reference","isActive":true},{"type":"text","text":" or define your own named units with"},{"type":"text","text":" "},{"identifier":"doc:\/\/Math\/documentation\/Math\/NamedUnit","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Build composite units dynamically by combining units with the "},{"type":"codeVoice","code":"*"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" "},{"type":"text","text":"operators defined for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"type":"text","text":" to define units for your own domain."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},{"type":"text","text":" to make dimension correctness a compile-time"},{"type":"text","text":" "},{"type":"text","text":"guarantee."}]}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/math\/workingwithquantity"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Math/documentation/Math/MathDimension/time":{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","abstract":[{"type":"text","text":"The compile-time dimension type representing time."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"time"}],"url":"\/documentation\/math\/mathdimension\/time","title":"MathDimension.time","navigatorTitle":[{"kind":"identifier","text":"time"}],"role":"symbol","type":"topic"},"doc://Math/documentation/Math/RatioUnit":{"title":"RatioUnit","kind":"symbol","url":"\/documentation\/math\/ratiounit","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RatioUnit","kind":"identifier"}],"abstract":[{"text":"A manually-constructed unit expressing the ","type":"text"},{"inlineContent":[{"text":"ratio","type":"text"}],"type":"emphasis"},{"text":" of one unit to another,","type":"text"},{"text":" ","type":"text"},{"text":"carrying both units as type parameters so the compiler can enforce which","type":"text"},{"text":" ","type":"text"},{"text":"side is which.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/RatioUnit","navigatorTitle":[{"text":"RatioUnit","kind":"identifier"}]},"doc://Math/documentation/Math/Quantity/formatted(decimalPlaces:includeSpace:)":{"title":"formatted(decimalPlaces:includeSpace:)","conformance":{"constraints":[{"code":"U","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"MathUnit","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"abstract":[{"text":"Formats the quantity value with its unit symbol placed on the correct side (prefix or suffix).","type":"text"}],"type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/formatted(decimalPlaces:includeSpace:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"formatted"},{"kind":"text","text":"("},{"kind":"externalParam","text":"decimalPl
{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Compile-Time Dimension Type Safety","modules":[{"name":"Math"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"abstract":[{"type":"text","text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity."}],"seeAlsoSections":[{"generated":true,"anchor":"Extending-the-Framework","title":"Extending the Framework","identifiers":["doc:\/\/Math\/documentation\/Math\/CustomDimensions"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Every "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","isActive":true},{"type":"text","text":" carries a compile-time dimension type through its"},{"type":"text","text":" "},{"type":"codeVoice","code":"Dimension"},{"type":"text","text":" associated type. That type is a "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","isActive":true},{"type":"text","text":"-conforming"},{"type":"text","text":" "},{"type":"text","text":"struct from the "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","isActive":true},{"type":"text","text":" namespace, such as "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","isActive":true},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","isActive":true},{"type":"text","text":". Because the compiler can see this type, it can"},{"type":"text","text":" "},{"type":"text","text":"reject dimension mismatches "},{"type":"emphasis","inlineContent":[{"type":"text","text":"when you build your app"}]},{"type":"text","text":" instead of when it runs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Historically, dimensions were only checked at runtime. With compile-time"},{"type":"text","text":" "},{"type":"text","text":"constraints, a function that declares "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“only lengths, please”"}]},{"text":" is enforced by","type":"text"},{"text":" ","type":"text"},{"text":"the Swift type checker.","type":"text"}],"type":"paragraph"},{"text":"Constrain a Generic to a Dimension","level":3,"anchor":"Constrain-a-Generic-to-a-Dimension","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Write a generic function or protocol requirement over a unit type ","type":"text"},{"code":"U: MathUnit","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"then constrain ","type":"text"},{"code":"U.Dimension","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"where","type":"codeVoice"},{"text":" clause:","type":"text"}]},{"code":["import Math","","\/\/ This method only accepts quantities of length.","func measureDistance<U: MathUnit>(_ distance: Quantity<U>) -> Bool","where U.Dimension == MathDimension.length {","    distance.value > 0","}"],"type":"codeListing","syntax":"swift"},{"text":"Passing the Correct Units","level":3,"anchor":"Passing-the-Correct-Units","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The built-in units in "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units","isActive":true},{"type":"text","text":" are already parameterized by their dimension."},{"type":"text","text":" "},{"type":"text","text":"Passing a length unit compiles cleanly:"}]},{"code":["let radius = Quantity(value: 500, unit: Units.meter)","measureDistance(radius) \/\/ Compiles perfectly! ✅"],"type":"codeListing","syntax":"swift"},{"text":"Preventing Mismatched Units","level":3,"anchor":"Preventing-Mismatched-Units","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Passing a quantity of a different dimension is a compile-time error:","type":"text"}]},{"code":["let timeLimit = Quantity(value: 30, unit: Units.minute)","measureDistance(timeLimit) \/\/ ✗ ERROR: 'time' is not 'length'"],"type":"codeListing","syntax":"swift"},{"text":"Runtime Checks for Dynamic Dimensions","level":3,"anchor":"Runtime-Checks-for-Dynamic-Dimensions","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Not every quantity has a static dimension. Custom dimensions created at runtime","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"text":") use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown"},{"text":" as their type-level","type":"text"},{"text":" ","type":"text"},{"text":"parameter. For those, the compiler can’t help—so ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math"},{"text":" keeps its runtime","type":"text"},{"text":" ","type":"text"},{"text":"safety net. Operations that combine quantities verify that dimensions match and","type":"text"},{"text":" ","type":"text"},{"text":"raise a runtime ","type":"text"},{"type":"codeVoice","code":"preconditionFailure"},{"text":" if they don’t:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let usdDimension = PhysicalDimension(exponents: [\"USD\": 1])","let usdUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"$\", dimension: usdDimension, converter: LinearConverter(coefficient: 1.0)",")","","let userDimension = PhysicalDimension(exponents: [\"user\": 1])","let userUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"user\", dimension: userDimension, converter: LinearConverter(coefficient: 1.0)",")","","\/\/ Traps at runtime: USD ≠ users","let revenue = Quantity(value: 100, unit: usdUnit) + Quantity(value: 3, unit: userUnit)"]},{"type":"heading","level":3,"text":"Applying Constraints at the Protocol Level","anchor":"Applying-Constraints-at-the-Protocol-Level"},{"type":"paragraph","inlineContent":[{"text":"You can attach the same constraint to a protocol so every conformer enforces it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["protocol DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Decimal","    where U.Dimension == MathDimension.length","}","","\/\/ All built-in length units satisfy this automatically:","struct RangeFinder: DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Decimal","    where U.Dimension == MathDimension.length {","        distance.converted(to: Units.meter).value","    }","}","","let width = Quantity(value: 10, unit: Units.foot)","RangeFinder().measure(width) \/\/ 3.048"]},{"type":"heading","level":3,"text":"What’s Next?","anchor":"Whats-Next"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See the full list of compile-time dimensions in "},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combine compile-time safety with your own domain in "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","isActive":true},{"type":"text","text":"."}]}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/compiletimesafety"]}],"references":{"doc://Math/documentation/Math/DimensionProtocol":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"DimensionProtocol","kind":"identifier"}],"title":"DimensionProtocol","type":"topic","abstract":[{"text":"A protocol representing a type-level identifier for a physical dimension.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"DimensionProtocol","kind":"identifier"}],"identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","url":"\/documentation\/math\/dimensionprotocol"},"doc://Math/documentation/Math/MathUnit":{"title":"MathUnit","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","abstract":[{"text":"A unit of measurement, such as a meter, a second, or a US dollar.","type":"text"}],"url":"\/documentation\/math\/mathunit","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MathUnit","kind":"identifier"}],"navigatorTitle":[{"text":"MathUnit","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://Math/documentation/Math/MathDimension/length":{"abstract":[{"text":"The compile-time dimension type representing length.","type":"text"}],"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"length","kind":"identifier"}],"url":"\/documentation\/math\/mathdimension\/length","navigatorTitle":[{"text":"length","kind":"identifier"}],"type":"topic","title":"MathDimension.length","kind":"symbol","role":"symbol"},"doc://Math/documentation/Math/CustomDimensions":{"role":"article","abstract":[{"type":"text","text":"Extend "},{"code":"Math","type":"codeVoice"},{"type":"text","text":" with your own physical dimensions and units—currency, points, gameplay metrics, or anything else your app measures."}],"kind":"article","url":"\/documentation\/math\/customdimensions","type":"topic","title":"Custom Dimensions and Units","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},"doc://Math/documentation/Math/MathDimension/time":{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","abstract":[{"type":"text","text":"The compile-time dimension type representing time."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"time"}],"url":"\/documentation\/math\/mathdimension\/time","title":"MathDimension.time","navigatorTitle":[{"kind":"identifier","text":"time"}],"role":"symbol","type":"topic"},"doc://Math/documentation/Math/MathDimension/unknown":{"kind":"symbol","title":"MathDimension.unknown","url":"\/documentation\/math\/mathdimension\/unknown","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"abstract":[{"text":"The compile-time dimension type used for dimensions that don’t have a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"static type, such as custom dimensions created at runtime."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown","navigatorTitle":[{"kind":"identifier","text":"unknown"}]},"doc://Math/documentation/Math":{"title":"Math","type":"topic","role":"collection","url":"\/documentation\/math","identifier":"doc:\/\/Math\/documentation\/Math","kind":"symbol","abstract":[{"text":"Perform type-safe dimensional analysis and unit conversion in your Swift app.","type":"text"}]},"doc://Math/documentation/Math/Units":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Units"}],"title":"Units","url":"\/documentation\/math\/units","navigatorTitle":[{"kind":"identifier","text":"Units"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/Units","abstract":[{"text":"A namespace of ready-made units for every dimension in the framework.","type":"text"}]},"doc://Math/documentation/Math/MathDimension":{"url":"\/documentation\/math\/mathdimension","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","title":"MathDimension","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MathDimension"}],"kind":"symbol","abstract":[{"text":"A namespace containing type-level structures for compile-time physical dimension verification.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MathDimension"}]}}}
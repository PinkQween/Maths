n\/Math\/MathUnit"},{"type":"text","text":", you can price anything per count"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit\/per(_:)"},{"type":"text","text":". The count cancels exactly like any other unit:"}],"type":"paragraph"},{"syntax":"swift","code":["let pricePerEgg = Quantity(value: 0.25, unit: Units.usd.per(egg))","let carton = Quantity(value: 2, unit: dozenEggs)","","let total = pricePerEgg * carton","print(total.formatted()) \/\/ $6.00"],"type":"codeListing"},{"inlineContent":[{"text":"The ratio keeps the count family, so a price per egg cannot accidentally be","type":"text"},{"text":" ","type":"text"},{"text":"applied to apples. A generic per-dozen price can still be applied to any item:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let pricePerDozen = Quantity(value: 3.00, unit: Units.usd.per(Units.Count.dozen))","let cost = pricePerDozen * carton \/\/ $6.00"],"type":"codeListing"},{"text":"Blending and inventory","anchor":"Blending-and-inventory","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Addition converts the right-hand side into the left-hand side’s unit, so"},{"type":"text","text":" "},{"type":"text","text":"inventory and recipe totals stay in whatever count scale you choose:"}],"type":"paragraph"},{"syntax":"swift","code":["let recipe = Quantity(value: 5, unit: egg)","           + Quantity(value: 2, unit: dozenEggs)","print(recipe) \/\/ 29.00 egg","","let cartons = recipe.converted(to: dozenEggs)","print(cartons.value) \/\/ 2.4166..."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Storing "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/baseCount()","isActive":true,"type":"reference"},{"text":" gives you a stable, factor-1 reading for","type":"text"},{"text":" ","type":"text"},{"text":"database rows and stock counts:","type":"text"}],"type":"paragraph"},{"type":"codeLis
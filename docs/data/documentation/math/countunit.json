":"text","text":"). Two count"},{"type":"text","text":" "},{"type":"text","text":"units with different items do "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" convert: eggs and apples are both","type":"text"},{"text":" ","type":"text"},{"text":"dimensionless, but they are not interchangeable.","type":"text"}],"type":"paragraph"},{"code":["let apple = CountUnit(item: \"apple\")","","egg.isCompatible(with: dozenEggs) \/\/ true","egg.isCompatible(with: apple)     \/\/ false"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A count unit created without an item is a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"generic"}]},{"type":"text","text":" count ("},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count","type":"reference","isActive":true},{"type":"text","text":" "},{"text":"contains common ones such as ","type":"text"},{"code":"each","type":"codeVoice"},{"text":", ","type":"text"},{"code":"pair","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dozen"},{"text":", and ","type":"text"},{"code":"gross","type":"codeVoice"},{"text":"). Generic","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"counts act as a wildcard and interoperate with identified counts, which is"},{"type":"text","text":" "},{"type":"text","text":"handy for shared counting scales."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/CountingUnits","type":"reference"}]}],"name":"See Also","style":"note","type":"aside"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"title":"Units","anchor":"Units","identifiers":["doc:\/\/Math\/documentation\/Math\/MathUnit","doc:\/\/Math\/documentation\/Math\/NamedUnit","doc:\/\/Math\/documentation\/Math\/CompositeUnit","doc:\/\/Math\/documentation\/Math\/Units"]}],"metadata":{"externalID":"s:4Math9CountUnitV","title":"C
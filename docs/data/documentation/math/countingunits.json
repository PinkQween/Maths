{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"kind":"article","identifier":{"url":"doc:\/\/Math\/documentation\/Math\/CountingUnits","interfaceLanguage":"swift"},"abstract":[{"text":"Create unlimited, identifiable dimensionless units for counting eggs, apples,","type":"text"},{"text":" ","type":"text"},{"text":"bottles, cases, and anything else your point-of-sale or inventory app tracks.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/countingunits"]}],"seeAlsoSections":[{"anchor":"Counting-and-Inventory","identifiers":["doc:\/\/Math\/documentation\/Math\/Units\/Count","doc:\/\/Math\/documentation\/Math\/Quantity\/baseCount()"],"generated":true,"title":"Counting and Inventory"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Some quantities are measured; others are counted. A recipe uses 3 eggs, a","type":"text"},{"text":" ","type":"text"},{"text":"carton holds 12, and a case holds 360. Counts are ","type":"text"},{"inlineContent":[{"type":"text","text":"dimensionless"}],"type":"strong"},{"text":"—they have no","type":"text"},{"text":" ","type":"text"},{"text":"meters, grams, or seconds—but they still need identity: eggs and apples are not","type":"text"},{"text":" ","type":"text"},{"text":"interchangeable just because both are dimensionless.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Math\/documentation\/Math\/CountUnit","type":"reference","isActive":true},{"text":" is a runtime-extensible count unit. There is no fixed catalog, so","type":"text"},{"text":" ","type":"text"},{"text":"you can create as many item-specific count units as your app needs:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Math","","let egg = CountUnit(item: \"egg\")","let dozenEggs = CountUnit(item: \"egg\", symbol: \"doz\", factor: 12)","let caseOfEggs = CountUnit(item: \"egg\", symbol: \"case\", factor: 360)","","let apple = CountUnit(item: \"apple\")","let caseOfApples = CountUnit(item: \"apple\", symbol: \"case\", factor: 120)"]},{"type":"paragraph","inlineContent":[{"text":"Every count unit is still dimensionless, so it works with the rest of ","type":"text"},{"type":"codeVoice","code":"Math"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"per-count prices, ratios, blending, and inventory totals.","type":"text"}]},{"type":"heading","text":"Quick start","level":2,"anchor":"Quick-start"},{"syntax":"swift","type":"codeListing","code":["import Math","","\/\/ 1. Create item-specific count units at runtime.","let egg = CountUnit(item: \"egg\")","let dozenEggs = CountUnit(item: \"egg\", symbol: \"doz\", factor: 12)","let caseOfEggs = CountUnit(item: \"egg\", symbol: \"case\", factor: 360)","","\/\/ 2. Count quantities.","let carton = Quantity(value: 2, unit: dozenEggs)","let loose = Quantity(value: 5, unit: egg)","","\/\/ 3. Convert within the same item family.","carton.converted(to: egg) \/\/ 24 egg","carton.baseCount()        \/\/ 24 egg","","\/\/ 4. Blend counts; the right-hand side converts to the left-hand unit.","let total = loose + carton                     \/\/ 29 egg","let inCartons = total.converted(to: dozenEggs) \/\/ 2.4166... doz","","\/\/ 5. Price per count; the count cancels and leaves currency.","let pricePerEgg = Quantity(value: 0.25, unit: Units.usd.per(egg))","let cost = pricePerEgg * carton \/\/ $6.00","","\/\/ 6. Generic scales act as wildcards.","let pricePerDozen = Quantity(value: 3.00, unit: Units.usd.per(Units.Count.dozen))","pricePerDozen * carton \/\/ $6.00","","\/\/ 7. Generic counts and leading-dot lookup.","let dozens = Quantity(value: 2, unit: .dozen)","dozens.converted(to: .each) \/\/ 24 ea","","\/\/ 8. Different items stay separate.","let apple = CountUnit(item: \"apple\")","egg.isCompatible(with: apple) \/\/ false"]},{"type":"heading","level":2,"anchor":"Item-families","text":"Item families"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"item"},{"type":"text","text":" is the unit’s "},{"type":"strong","inlineContent":[{"type":"text","text":"conversion family"}]},{"type":"text","text":". Units in the same family convert"},{"type":"text","text":" "},{"type":"text","text":"freely, even when their scales differ:"}]},{"syntax":"swift","type":"codeListing","code":["let carton = Quantity(value: 2, unit: dozenEggs)","print(carton.converted(to: egg).value) \/\/ 24","print(carton.baseCount().value)        \/\/ 24 (the family's factor-1 reading)"]},{"type":"paragraph","inlineContent":[{"text":"Units in different families do not convert, so eggs cannot silently become","type":"text"},{"text":" ","type":"text"},{"text":"apples:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["egg.isCompatible(with: dozenEggs) \/\/ true","egg.isCompatible(with: apple)     \/\/ false"]},{"type":"paragraph","inlineContent":[{"text":"A count unit created without an item is a ","type":"text"},{"inlineContent":[{"type":"text","text":"generic"}],"type":"strong"},{"text":" counting scale. Generic","type":"text"},{"text":" ","type":"text"},{"text":"counts act as a wildcard, so shared scales work with any item:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let dozen = Units.Count.dozen       \/\/ generic \"doz\", factor 12","let dozenEggs = dozen.forItem(\"egg\", symbol: \"doz\")","let dozenApples = dozen.forItem(\"apple\", symbol: \"doz\")"]},{"type":"heading","level":2,"anchor":"Per-count-pricing","text":"Per-count pricing"},{"type":"paragraph","inlineContent":[{"text":"Because a count unit conforms to ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","type":"reference","isActive":true},{"text":", you can price anything per count","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit\/per(_:)","type":"reference","isActive":true},{"text":". The count cancels exactly like any other unit:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let pricePerEgg = Quantity(value: 0.25, unit: Units.usd.per(egg))","let carton = Quantity(value: 2, unit: dozenEggs)","","let total = pricePerEgg * carton","print(total.formatted()) \/\/ $6.00"]},{"type":"paragraph","inlineContent":[{"text":"The ratio keeps the count family, so a price per egg cannot accidentally be","type":"text"},{"text":" ","type":"text"},{"text":"applied to apples. A generic per-dozen price can still be applied to any item:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let pricePerDozen = Quantity(value: 3.00, unit: Units.usd.per(Units.Count.dozen))","let cost = pricePerDozen * carton \/\/ $6.00"]},{"type":"heading","level":2,"anchor":"Blending-and-inventory","text":"Blending and inventory"},{"type":"paragraph","inlineContent":[{"text":"Addition converts the right-hand side into the left-hand side’s unit, so","type":"text"},{"text":" ","type":"text"},{"text":"inventory and recipe totals stay in whatever count scale you choose:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let recipe = Quantity(value: 5, unit: egg)","           + Quantity(value: 2, unit: dozenEggs)","print(recipe) \/\/ 29.00 egg","","let cartons = recipe.converted(to: dozenEggs)","print(cartons.value) \/\/ 2.4166..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storing "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/baseCount()"},{"type":"text","text":" gives you a stable, factor-1 reading for"},{"type":"text","text":" "},{"type":"text","text":"database rows and stock counts:"}]},{"syntax":"swift","type":"codeListing","code":["let stock = Quantity(value: 3, unit: caseOfEggs).baseCount()","print(stock) \/\/ 1080.00 egg"]},{"type":"heading","level":2,"anchor":"Built-in-generic-scales","text":"Built-in generic scales"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count"},{"type":"text","text":" contains common counting scales that are not tied to an item:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unit"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Factor"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count\/each","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ea"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"1"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count\/piece","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"pc","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"1","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count\/pair","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"pair","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"2","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count\/halfDozen"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"half-doz"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"6"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count\/dozen","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"doz"}]}],[{"type":"paragraph","inlineContent":[{"type":"text",
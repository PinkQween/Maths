ve":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"energy"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"kelvin"},{"type":"text","text":", "},{"type":"codeVoice","code":"joule"},{"type":"text","text":", "},{"code":"calorie","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Currency"}]}],[{"type":"paragraph","inlineContent":[{"code":"currency","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":"usd"},{"type":"text","text":", "},{"type":"codeVoice","code":"eur"},{"type":"text","text":", "},{"type":"codeVoice","code":"btc"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"…and more","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"…","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"…"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Each namespace also exposes "},{"type":"codeVoice","code":"all"},{"type":"text","text":", an array of every base unit in its dimension,"},{"type":"text","text":" "},{"type":"text","text":"which is handy for building menus and pickers:"}],"type":"paragraph"},{"syntax":"swift","code":["for unit in Units.Volume.all {","    print(unit.symbol)","}"],"type":"codeListing"},{"level":4,"text":"Currency common names","type":"heading","anchor":"Currency-common-names"},{"inlineContent":[{"type":"text","text":"The currency dimension is special: most names are only meaningful with their"},{"type":"text","text":" "},{"type":"text","text":"country code, so the explicit spellings stay ("},{"type":"codeVoice","code":"Units.usd"},{"type":"text","text":", "},{"type":"codeVoice","code":"Units.cad"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Units.currency.mxn"},{"type":"text","text":", …). Currencies whose common name is unambiguous get"},{"type":"text","text":" "},{"type":"text","text":"colloquial aliases in every access style — "},{"type":"codeVoice","code":"Units.pounds"},{"type":"text","text":", "},{"type":"codeVoice","code":"Units.Currency.sterling"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"Quantity(value: 100, unit: .poundsSterling)"},{"text":" all refer to the British pound","type":"text"},{"text":" ","type":"text"},{"text":"(GBP), ","type":"text"},{"type":"codeVoice","code":".yen"},{"text":" to JPY, ","type":"text"},{"type":"codeVoice","code":".franc"},{"text":" to CHF, ","type":"text"},{"type":"codeVoice","code":".rupee"},{"text":" to INR, and so on. There is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately no bare ","type":"text"},{"type":"codeVoice","code":".dollar"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".peso"},{"text":", because those names span several","type":"text"},{"text":" ","type":"text"},{"text":"currencies.","type":"text"}],"type":"paragraph"},{"anchor":"Decibels","type":"heading","text":"Decibels","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decibels are logarithmic, so they are modeled with a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/PowerLawConverter","isActive":true},{"type":"text","text":" rather than a linear scale. Relative decibels are"},{"type":"text","text":" "},{"type":"text","text":"dimensionless power ratios ("},{"code":"10 dB = 10·log10(P₁\/P₂)","type":"codeVoice"},{"type":"text","text":", i.e. a tenfold power"},{"type":"text","text":" "},{"type":"text","text":"increase) and live in "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Dimensionless","type":"reference","isActive":true},{"text":" as ","type":"text"},{"code":"bel","type":"codeVoice"},{"type":"text","text":" and "},{"code":"decibel","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Absolute scales pin a reference at the zero reading and belong to the"},{"type":"text","text":" "},{"type":"text","text":"dimension they measure, so they convert exactly to the linear units of that"},{"type":"text","text":" "},{"type":"text","text":"dimension:"}]},{"type":"codeListing","code":["let power = Quantity(value: 30, unit: .decibelMilliwatt) \/\/ 30 dBm","print(power.converted(to: .watt).value)                  \/\/ 1.0  (0 dBm = 1 mW)","","let voltage = Quantity(value: 120, unit: .decibelMicrovolt)","print(voltage.converted(to: .volt).value)                \/\/ 1.0  (120 dBµV = 1 V)","","let quiet = Quantity(value: 0, unit: .decibelSoundPressureLevel)","print(quiet.converted(to: .pascal).value)                \/\/ 2e-5 (0 dB SPL = 20 µPa)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Power-ratio scales (","type":"text"},{"code":"decibelMilliwatt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"decibelWatt","type":"codeVoice"},{"text":", the dimensionless","type":"text"},{"text":" ","type":"text"},{"code":"decibel","type":"codeVoice"},{"text":") step by ","type":"text"},{"code":"10^(1\/10)","type":"codeVoice"},{"text":"; voltage and pressure scales","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"code":"decibelVolt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelMicrovolt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelSoundPressureLevel","type":"codeVoice"},{"type":"text","text":") use the"},{"type":"text","text":" "},{"type":"text","text":"field convention "},{"code":"10^(1\/20)","type":"codeVoice"},{"type":"text","text":" since they are squared into power."}]},{"text":"Counts and inventory","anchor":"Counts-and-inventory","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Counts are dimensionless, but they still need identity. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"text":"generic counting scales such as ","type":"text"},{"code":"each","type":"codeVoice"},{"text":", ","type":"text"},{"code":"pair","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dozen","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"gross","type":"codeVoice"},{"text":", while","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CountUnit"},{"text":" lets you create unlimited item-specific units for a POS or","type":"text"},{"text":" ","type":"text"},{"text":"inventory app:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let egg = CountUnit(item: \"egg\")","let dozenEggs = CountUnit(item: \"egg\", symbol: \"doz\", factor: 12)","","let carton = Quantity(value: 2, unit: dozenEggs)","print(carton.converted(to: egg).value) \/\/ 24","","let pricePerEgg = Quantity(value: 0.25, unit: Units.usd.per(egg))","print((pricePerEgg * carton).formatted()) \/\/ $6.00"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Eggs and apples are both dimensionless, but they do not convert to each other."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CountingUnits","isActive":true},{"type":"text","text":" for the full guide."}]},{"text":"Mass versus weight","type":"heading","level":3,"anchor":"Mass-versus-weight"},{"type":"paragraph","inlineContent":[{"text":"Mass and weight are different things, and the namespaces make the distinction","type":"text"},{"text":" ","type":"text"},{"text":"explicit so the two can never be mixed up.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass","isActive":true},{"type":"text","text":" contains the mass units — "},{"type":"codeVoice","code":"Units.Mass.ounce"},{"type":"text","text":" is the ounce of"},{"type":"text","text":" "},{"type":"text","text":"mass (symbol "},{"type":"codeVoice","code":"oz"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Weight"},{"text":" contains the force units, the physics-correct meaning of","type":"text"},{"text":" ","type":"text"},{"text":"“weight” — ","type":"text"},{"code":"Units.Weight.ounce","type":"codeVoice"},{"text":" is the ounce-force (symbol ","type":"text"},{"code":"ozf","type":"codeVoice"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"code":"Units.Weight.pound","type":"codeVoice"},{"type":"text","text":" is the pound-force (symbol "},{"code":"lbf","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Every avoirdupois mass unit has a matching weight (force) reading in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Weight","isActive":true},{"type":"text","text":": "},{"type":"codeVoice","code":"gram"},{"type":"text","text":", "},{"type":"codeVoice","code":"grain"},{"type":"text","text":", "},{"type":"codeVoice","code":"ounce"},{"type":"text","text":", "},{"type":"codeVoice","code":"pound"},{"type":"text","text":", "},{"type":"codeVoice","code":"dram"},{"type":"text","text":", "},{"type":"codeVoice","code":"stone"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"shortTon"},{"type":"text","text":", "},{"type":"codeVoice","code":"longTon"},{"type":"text","text":", "},{"type":"codeVoice","code":"hundredweight"},{"type":"text","text":", and "},{"type":"codeVoice","code":"longHundredweight"},{"type":"text","text":" there are all"},{"type":"text","text":" "},{"type":"text","text":"force units ("},{"type":"codeVoice","code":"gf"},{"type":"text","text":", "},{"type":"codeVoice","code":"grf"},{"type":"text","text":", "},{"type":"codeVoice","code":"ozf"},{"type":"text","text":", "},{"type":"codeVoice","code":"lbf"},{"type":"text","text":", "},{"code":"dramf","type":"codeVoice"},{"text":", ","type":"text"},{"code":"stf","type":"codeVoice"},{"text":", ","type":"text"},{"code":"stnf","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ltnf","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"cwtf","type":"codeVoice"},{"text":", ","type":"text"},{"code":"lcwtf","type":"codeVoice"},{"text":"), each equal to the standard-gravity weight of its mass","type":"text"},{"text":" ","type":"text"},{"text":"counterpart — ","type":"text"},{"code":"W = mg","type":"codeVoice"},{"text":". The troy and jewelry systems get the same treatment:","type":"text"},{"text":" ","type":"text"},{"code":"troyOunce","type":"codeVoice"},{"text":", ","type":"text"},{"code":"troyPound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"troyDram","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"pennyweight"},{"type":"text","text":", and "},{"type":"codeVoice","code":"carat"},{"type":"text","text":" also resolve"},{"type":"text","text":" "},{"type":"text","text":"as forces ("},{"type":"codeVoice","code":"ozf_t"},{"type":"text","text":", "},{"type":"codeVoice","code":"lbf_t"},{"type":"text","text":", "},{"type":"codeVoice","code":"drf_t"},{"type":"text","text":", "},{"type":"codeVoice","code":"dwtf"},{"type":"text","text":", "},{"type":"codeVoice","code":"ctf"},{"type":"text","text":"). The mass readings"},{"type":"text","text":" "},{"type":"text","text":"themselves stay in "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass","isActive":true,"type":"reference"},{"type":"text","text":", where "},{"type":"codeVoice","code":"slug"},{"type":"text","text":" is the canonical imperial unit"},{"type":"text","text":" "},{"type":"text","text":"of mass (1 slug ≈ 32.17 lbm)."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let force = Quantity(value: 1, unit: .weight.stone) \/\/ 1 stf = 14 lbf","let mass  = Quantity(value: 1, unit: .mass.stone)   \/\/ 1 st  = 14 lbm","let gramF = Quantity(value: 1, unit: .weight.gram)  \/\/ 1 gf   = 9.80665 mN","let troyF = Quantity(value: 1, unit: .weight.pennyweight) \/\/ 1 dwtf"]},{"type":"paragraph","inlineContent":[{"text":"Some words mean different physical things in different contexts. Beyond","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ounce"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"pound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dram"},{"text":" is available as a mass unit (","type":"text"},{"type":"codeVoice","code":"Units.Mass.dram"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"a weight\/force unit ("},{"type":"codeVoice","code":"Units.Weight.dram"},{"type":"text","text":", the dram-force), and a volume unit"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Units.Volume.dram"},{"type":"text","text":", the US fluid dram, one eighth of a US fluid ounce)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because they live in different namespaces, the compiler keeps the two apart:"}]},{"syntax":"swift","type":"codeListing","code":["let flour = Quantity(16, Units.Mass.ounce)   \/\/ 16 oz of mass","let force = Quantity(16, Units.Weight.ounce) \/\/ 16 ozf of force","let sack = Quantity(2, Units.Mass.dram)      \/\/ 2 dr of mass","let pull = Quantity(2, Units.Weight.dram)    \/\/ 2 dram-force","let dose = Quantity(2, Units.Volume.dram)    \/\/ 2 fl dr of volume"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For code that has to be unambiguous, the mass readings also come with explicit"},{"type":"text","text":" "},{"type":"text","text":"names: "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/poundMass","type":"reference","isActive":true},{"type":"text","text":" (symbol "},{"code":"lbm","type":"codeVoice"},{"text":") and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/ounceMass"},{"text":" (symbol","type":"text"},{"text":" ","type":"text"},{"code":"ozm","type":"codeVoice"},{"text":") spell out that they are masses, never forces.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiplying a mass by an acceleration already produces a force — both operand"},{"type":"text","text":" "},{"type":"text","text":"orders work, so "},{"type":"codeVoice","code":"mass × earth's gravity"},{"type":"text","text":" and "},{"code":"earth's gravity × mass","type":"codeVoice"},{"text":" give a","type":"text"},{"text":" ","type":"text"},{"text":"force quantity. The picker then restates it in whatever force unit reads","type":"text"},{"text":" ","type":"text"},{"text":"clearest.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let mass = Quantity(value: 1, unit: .kilogram)","let weight = mass * Quantity(value: 1, unit: .gravity) \/\/ force quantity","print(weight.simplified())  \/\/ 1 kgf — the cleanest reading"]},{"type":"paragraph","inlineContent":[{"text":"Mathematics in ","type":"text"},{"code":"Math","type":"codeVoice"},{"text":" lets you request the most readable unit for a result","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"directly with "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/simplified()-40uns","type":"reference","isActive":true},{"type":"text","text":", which scans the dimension’s catalog"},{"type":"text","text":" "},{"type":"text","text":"(including the SI-prefixed metric siblings) and picks the reading that is a"},{"type":"text","text":" "},{"type":"text","text":"whole number (smallest positive whole for a positive amount), falling back to"},{"type":"text","text":" "},{"type":"text","text":"the reading with the fewest decimal places."}]},{"code":["let rope = Quantity(value: 1000, unit: .meter)","print(rope.simplified())     \/\/ 1 km","","let thrust = Quantity(value: 2000, unit: .newton)","print(thrust.simplified())   \/\/ 2 kN","","let ride = Quantity(value: 3600, unit: .second)","print(ride.simplified())     \/\/ 1 hour"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Computing weight from mass","type":"heading","anchor":"Computing-weight-from-mass"},{"inlineContent":[{"text":"Weight is a force, ","type":"text"},{"type":"codeVoice","code":"W = mg"},{"text":". Any mass quantity exposes that via","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/weight","isActive":true},{"text":", which converts a mass to its weight at standard gravity","type":"text"},{"text":" ","type":"text"},{"text":"and returns a force quantity:","type":"text"}],"type":"paragraph"},{"code":["let person = Quantity(value: 150, unit: Units.pound) \/\/ 150 lbm","print(person.weight.converted(to: Units.poundForce).value) \/\/ ≈ 150.0 lbf"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"Quantity\/weight(on:)","type":"codeVoice"},{"type":"text","text":" for another gravitational field and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/weight(in:)"},{"type":"text","text":" to request a particular force unit:"}],"type":"paragraph"},{"code":["let probe = Quantity(value: 100, unit: Units.kilogram)","print(probe.weight(on: 1.62).converted(to: Units.newton).value) \/\/ ≈ 162 N on the Moon"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Leading-dot lookup","type":"heading","anchor":"Leading-dot-lookup"},{"inlineContent":[{"type":"text","text":"Inside a "},{"type":"codeVoice","code":"Quantity"},{"type":"text","text":" initializer — whose "},{"code":"unit:","type":"codeVoice"},{"text":" parameter is a generic","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"U: MathUnit"},{"text":" — the dimensions are available as leading-dot namespaces:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let oil = Quantity(value: 10, unit: .volume.fluidOunce)","let punch = Quantity(value: 2, unit: .volume.liter).converted(to: .volume.cup)","let force = Quantity(value: 150, unit: .weight.pound)"],"type":"codeListing"},{"inlineContent":[{"text":"The first member (","type":"text"},{"code":".volume","type":"codeVoice"},{"text":", ","type":"text"},{"code":".mass","type":"codeVoice"},{"text":", ","type":"text"},{"code":".weight","type":"codeVoice"},{"text":", …) resolves to that","type":"text"},{"text":" ","type":"text"},{"text":"dimension’s namespace, and the second member chains onto any of its units —","type":"text"},{"text":" ","type":"text"},{"text":"base or prefixed. The mass-versus-weight rule still applies: ","type":"text"},{"code":".mass.pound","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"mass unit and ","type":"text"},{"code":".weight.pound","type":"codeVoice"},{"text":" is a force unit.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let precise = Quantity(value: 1, unit: .voltage.nanovolt) \/\/ nV","let sticky  = Quantity(value: 500, unit: .volume.milliliter)","let disk    = Quantity(value: 1, unit: .data.gibibyte)    \/\/ GiB"],"type":"codeListing"},{"inlineContent":[{"text":"Every unit is also available bare, without the dimension name: ","type":"text"},{"code":".nanovolt","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":".voltage.nanovolt","type":"codeVoice"},{"text":" are the same unit. The ","type":"text"},{"code":"Units.units(for:)","type":"codeVoice"},{"text":" catalog keeps","type":"text"},{"text":" ","type":"text"},{"text":"listing just the base units of each dimension, so the pickers stay compact.","type":"text"}],"type":"paragraph"},{"text":"Looking units up at runtime","level":3,"anchor":"Looking-units-up-at-runtime","type":"heading"},{"inlineC
{"sections":[],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Every "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","isActive":true},{"type":"text","text":" carries a compile-time dimension type through its"},{"type":"text","text":" "},{"type":"codeVoice","code":"Dimension"},{"type":"text","text":" associated type. That type is a "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","isActive":true},{"type":"text","text":"-conforming"},{"type":"text","text":" "},{"type":"text","text":"struct from the "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","isActive":true},{"type":"text","text":" namespace, such as "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","isActive":true},{"type":"text","text":" "},{"text":"or ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","isActive":true},{"text":". Because the compiler can see this type, it can","type":"text"},{"type":"text","text":" "},{"text":"reject dimension mismatches ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"when you build your app","type":"text"}]},{"text":" instead of when it runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Historically, dimensions were only checked at runtime. With compile-time"},{"text":" ","type":"text"},{"text":"constraints, a function that declares ","type":"text"},{"inlineContent":[{"type":"text","text":"“only lengths, please”"}],"type":"emphasis"},{"text":" is enforced by","type":"text"},{"type":"text","text":" "},{"text":"the Swift type checker.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Constrain a Generic to a Dimension","anchor":"Constrain-a-Generic-to-a-Dimension"},{"type":"paragraph","inlineContent":[{"text":"Write a generic function or protocol requirement over a unit type ","type":"text"},{"code":"U: MathUnit","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"then constrain ","type":"text"},{"code":"U.Dimension","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"where","type":"codeVoice"},{"text":" clause:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Math","","\/\/ This method only accepts quantities of length.","func measureDistance<U: MathUnit>(_ distance: Quantity<U>) -> Bool","where U.Dimension == MathDimension.length {","    distance.value > 0","}"]},{"type":"heading","level":3,"text":"Passing the Correct Units","anchor":"Passing-the-Correct-Units"},{"type":"paragraph","inlineContent":[{"text":"The built-in units in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units"},{"text":" are already parameterized by their dimension.","type":"text"},{"text":" ","type":"text"},{"text":"Passing a length unit compiles cleanly:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let radius = Quantity(value: 500, unit: Units.meter)","measureDistance(radius) \/\/ Compiles perfectly! ✅"]},{"type":"heading","level":3,"text":"Preventing Mismatched Units","anchor":"Preventing-Mismatched-Units"},{"type":"paragraph","inlineContent":[{"text":"Passing a quantity of a different dimension is a compile-time error:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let timeLimit = Quantity(value: 30, unit: Units.minute)","measureDistance(timeLimit) \/\/ ✗ ERROR: 'time' is not 'length'"]},{"type":"heading","level":3,"text":"Runtime Checks for Dynamic Dimensions","anchor":"Runtime-Checks-for-Dynamic-Dimensions"},{"type":"paragraph","inlineContent":[{"text":"Not every quantity has a static dimension. Custom dimensions created at runtime","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"text":") use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown"},{"text":" as their type-level","type":"text"},{"text":" ","type":"text"},{"text":"parameter. For those, the compiler can’t help—so ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math"},{"text":" keeps its runtime","type":"text"},{"text":" ","type":"text"},{"text":"safety net. Operations that combine quantities verify that dimensions match and","type":"text"},{"text":" ","type":"text"},{"text":"raise a runtime ","type":"text"},{"code":"preconditionFailure","type":"codeVoice"},{"text":" if they don’t:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let usdDimension = PhysicalDimension(exponents: [\"USD\": 1])","let usdUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"$\", dimension: usdDimension, converter: LinearConverter(coefficient: 1.0)",")","","let userDimension = PhysicalDimension(exponents: [\"user\": 1])","let userUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"user\", dimension: userDimension, converter: LinearConverter(coefficient: 1.0)",")","","\/\/ Traps at runtime: USD ≠ users","let revenue = Quantity(value: 100, unit: usdUnit) + Quantity(value: 3, unit: userUnit)"]},{"type":"heading","level":3,"text":"Applying Constraints at the Protocol Level","anchor":"Applying-Constraints-at-the-Protocol-Level"},{"type":"paragraph","inlineContent":[{"text":"You can attach the same constraint to a protocol so every conformer enforces it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["protocol DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Decimal","    where U.Dimension == MathDimension.length","}","","\/\/ All built-in length units satisfy this automatically:","struct RangeFinder: DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Decimal","    where U.Dimension == MathDimension.length {","        distance.converted(to: Units.meter).value","    }","}","","let width = Quantity(value: 10, unit: Units.foot)","RangeFinder().measure(width) \/\/ 3.048"]},{"type":"heading","level":3,"text":"What’s Next?","anchor":"Whats-Next"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See the full list of compile-time dimensions in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Combine compile-time safety with your own domain in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","type":"reference","isActive":true},{"text":".","type":"text"}]}]}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/math\/compiletimesafety"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Compile-Time Dimension Type Safety","role":"article","modules":[{"name":"Math"}]},"abstract":[{"text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},"seeAlsoSections":[{"title":"Extending the Framework","identifiers":["doc:\/\/Math\/documentation\/Math\/CustomDimensions"],"generated":true,"anchor":"Extending-the-Framework"}],"kind":"article","references":{"doc://Math/documentation/Math/MathUnit":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MathUnit","kind":"identifier"}],"type":"topic","url":"\/documentation\/math\/mathunit","role":"symbol","title":"MathUnit","navigatorTitle":[{"text":"MathUnit","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","abstract":[{"text":"A unit of measurement, such as a meter, a second, or a US dollar.","type":"text"}]},"doc://Math/documentation/Math/MathDimension/unknown":{"url":"\/documentation\/math\/mathdimension\/unknown","title":"MathDimension.unknown","role":"symbol","abstract":[{"text":"The compile-time dimension type used for dimensions that don’t have a","type":"text"},{"text":" ","type":"text"},{"text":"static type, such as custom dimensions created at runtime.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}],"navigatorTitle":[{"text":"unknown","kind":"identifier"}],"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown"},"doc://Math/documentation/Math/MathDimension/length":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"length","kind":"identifier"}],"type":"topic","url":"\/documentation\/math\/mathdimension\/length","role":"symbol","title":"MathDimension.length","navigatorTitle":[{"text":"length","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","abstract":[{"type":"text","text":"The compile-time dimension type representing length."}]},"doc://Math/documentation/Math/MathDimension/time":{"url":"\/documentation\/math\/mathdimension\/time","title":"MathDimension.time","role":"symbol","abstract":[{"text":"The compile-time dimension type representing time.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"}],"navigatorTitle":[{"text":"time","kind":"identifier"}],"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time"},"doc://Math/documentation/Math":{"kind":"symbol","identifier":"doc:\/\/Math\/documentation\/Math","title":"Math","type":"topic","url":"\/documentation\/math","role":"collection","abstract":[{"type":"text","text":"Perform type-safe dimensional analysis and unit conversion in your Swift app."}]},"doc://Math/documentation/Math/DimensionProtocol":{"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"DimensionProtocol","kind":"identifier"}],"type":"topic","url":"\/documentation\/math\/dimensionprotocol","role":"symbol","title":"DimensionProtocol","navigatorTitle":[{"text":"DimensionProtocol","kind":"identifier"}],"identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","kind":"symbol","abstract":[{"text":"A protocol representing a type-level identifier for a physical dimension.","type":"text"}]},"doc://Math/documentation/Math/Units":{"navigatorTitle":[{"text":"Units","kind":"identifier"}],"role":"symbol","title":"Units","abstract":[{"type":"text","text":"A namespace of ready-made units for every dimension in the framework."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Units","kind":"identifier"}],"type":"topic","url":"\/documentation\/math\/units","identifier":"doc:\/\/Math\/documentation\/Math\/Units","kind":"symbol"},"doc://Math/documentation/Math/MathDimension":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MathDimension","kind":"identifier"}],"type":"topic","url":"\/documentation\/math\/mathdimension","role":"symbol","title":"MathDimension","navigatorTitle":[{"text":"MathDimension","kind":"identifier"}],"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","kind":"symbol","abstract":[{"type":"text","text":"A namespace containing type-level structures for compile-time physical dimension verification."}]},"doc://Math/documentation/Math/CustomDimensions":{"role":"article","kind":"article","type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","title":"Custom Dimensions and Units","abstract":[{"type":"text","text":"Extend "},{"code":"Math","type":"codeVoice"},{"type":"text","text":" with your own physical dimensions and units—currency, points, gameplay metrics, or anything else your app measures."}],"url":"\/documentation\/math\/customdimensions"}}}
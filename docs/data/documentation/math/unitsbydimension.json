{"abstract":[{"type":"text","text":"Browse the unit catalog one dimension at a time, and keep mass and weight straight."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Math\/documentation\/Math\/UnitsByDimension"},"metadata":{"role":"article","modules":[{"name":"Math"}],"title":"Looking Up Units by Dimension","roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Math\/documentation\/Math\/GettingStarted","doc:\/\/Math\/documentation\/Math\/WorkingWithQuantity","doc:\/\/Math\/documentation\/Math\/StoringAndEncodingQuantities","doc:\/\/Math\/documentation\/Math\/Quantity"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every unit in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units"},{"type":"text","text":" is defined twice: once as a flat, ready-made value"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Units.cup"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Units.newton"},{"text":"), and once under a namespace named after its","type":"text"},{"text":" ","type":"text"},{"text":"dimension (","type":"text"},{"type":"codeVoice","code":"Units.Volume.cup"},{"type":"text","text":", "},{"code":"Units.Weight.newton","type":"codeVoice"},{"type":"text","text":"). The namespaces give you"},{"type":"text","text":" "},{"type":"text","text":"a way to see, enumerate, and pick from just one dimension."}]},{"anchor":"The-dimension-namespaces","type":"heading","level":2,"text":"The dimension namespaces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated namespaces mirror the framework’s dimensions:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Namespace","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Dimension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Example units","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Length","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"length"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"meter"},{"text":", ","type":"text"},{"type":"codeVoice","code":"mile"},{"text":", ","type":"text"},{"type":"codeVoice","code":"lightYear"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Time","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"time","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"second","type":"codeVoice"},{"type":"text","text":", "},{"code":"hour","type":"codeVoice"},{"type":"text","text":", "},{"code":"day","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass"}]}],[{"type":"paragraph","inlineContent":[{"code":"mass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"gram"},{"type":"text","text":", "},{"type":"codeVoice","code":"pound"},{"type":"text","text":", "},{"code":"slug","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Volume"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"volume"}]}],[{"type":"paragraph","inlineContent":[{"code":"cup","type":"codeVoice"},{"type":"text","text":", "},{"code":"liter","type":"codeVoice"},{"type":"text","text":", "},{"code":"gallon","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Data"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"data"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"byte"},{"type":"text","text":", "},{"code":"gibibyte","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Energy","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"energy"}],"type":"paragraph"}],[{"inlineContent":[{"code":"kelvin","type":"codeVoice"},{"type":"text","text":", "},{"code":"joule","type":"codeVoice"},{"type":"text","text":", "},{"code":"calorie","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Currency"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"currency","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"usd","type":"codeVoice"},{"text":", ","type":"text"},{"code":"eur","type":"codeVoice"},{"text":", ","type":"text"},{"code":"btc","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"…and more"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"…"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"…"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each namespace also exposes "},{"type":"codeVoice","code":"all"},{"type":"text","text":", an array of every base unit in its dimension,"},{"type":"text","text":" "},{"type":"text","text":"which is handy for building menus and pickers:"}]},{"code":["for unit in Units.Volume.all {","    print(unit.symbol)","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Currency-common-names","type":"heading","level":4,"text":"Currency common names"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The currency dimension is special: most names are only meaningful with their"},{"type":"text","text":" "},{"type":"text","text":"country code, so the explicit spellings stay ("},{"type":"codeVoice","code":"Units.usd"},{"type":"text","text":", "},{"type":"codeVoice","code":"Units.cad"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Units.currency.mxn"},{"type":"text","text":", …). Currencies whose common name is unambiguous get"},{"type":"text","text":" "},{"type":"text","text":"colloquial aliases in every access style — "},{"type":"codeVoice","code":"Units.pounds"},{"type":"text","text":", "},{"type":"codeVoice","code":"Units.Currency.sterling"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"Quantity(value: 100, unit: .poundsSterling)"},{"type":"text","text":" all refer to the British pound"},{"type":"text","text":" "},{"type":"text","text":"(GBP), "},{"type":"codeVoice","code":".yen"},{"type":"text","text":" to JPY, "},{"type":"codeVoice","code":".franc"},{"type":"text","text":" to CHF, "},{"type":"codeVoice","code":".rupee"},{"type":"text","text":" to INR, and so on. There is"},{"type":"text","text":" "},{"type":"text","text":"deliberately no bare "},{"type":"codeVoice","code":".dollar"},{"type":"text","text":" or "},{"type":"codeVoice","code":".peso"},{"type":"text","text":", because those names span several"},{"type":"text","text":" "},{"type":"text","text":"currencies."}]},{"anchor":"Decibels","type":"heading","level":4,"text":"Decibels"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decibels are logarithmic, so they are modeled with a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PowerLawConverter"},{"type":"text","text":" rather than a linear scale. Relative decibels are"},{"type":"text","text":" "},{"type":"text","text":"dimensionless power ratios ("},{"type":"codeVoice","code":"10 dB = 10·log10(P₁\/P₂)"},{"type":"text","text":", i.e. a tenfold power"},{"type":"text","text":" "},{"type":"text","text":"increase) and live in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Dimensionless"},{"type":"text","text":" as "},{"type":"codeVoice","code":"bel"},{"type":"text","text":" and "},{"type":"codeVoice","code":"decibel"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Absolute scales pin a reference at the zero reading and belong to the"},{"type":"text","text":" "},{"type":"text","text":"dimension they measure, so they convert exactly to the linear units of that"},{"type":"text","text":" "},{"type":"text","text":"dimension:"}]},{"code":["let power = Quantity(value: 30, unit: .decibelMilliwatt) \/\/ 30 dBm","print(power.converted(to: .watt).value)                  \/\/ 1.0  (0 dBm = 1 mW)","","let voltage = Quantity(value: 120, unit: .decibelMicrovolt)","print(voltage.converted(to: .volt).value)                \/\/ 1.0  (120 dBµV = 1 V)","","let quiet = Quantity(value: 0, unit: .decibelSoundPressureLevel)","print(quiet.converted(to: .pascal).value)                \/\/ 2e-5 (0 dB SPL = 20 µPa)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Power-ratio scales (","type":"text"},{"code":"decibelMilliwatt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelWatt","type":"codeVoice"},{"type":"text","text":", the dimensionless"},{"type":"text","text":" "},{"code":"decibel","type":"codeVoice"},{"type":"text","text":") step by "},{"code":"10^(1\/10)","type":"codeVoice"},{"type":"text","text":"; voltage and pressure scales"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"decibelVolt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelMicrovolt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelSoundPressureLevel","type":"codeVoice"},{"type":"text","text":") use the"},{"type":"text","text":" "},{"type":"text","text":"field convention "},{"code":"10^(1\/20)","type":"codeVoice"},{"text":" since they are squared into power.","type":"text"}]},{"text":"Counts and inventory","anchor":"Counts-and-inventory","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Counts are dimensionless, but they still need identity. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"text":"generic counting scales such as ","type":"text"},{"type":"codeVoice","code":"each"},{"text":", ","type":"text"},{"type":"codeVoice","code":"pair"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dozen"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"gross"},{"text":", while","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CountUnit","isActive":true},{"text":" lets you create unlimited item-specific units for a POS or","type":"text"},{"text":" ","type":"text"},{"text":"inventory app:","type":"text"}]},{"code":["let egg = CountUnit(item: \"egg\")","let dozenEggs = CountUnit(item: \"egg\", symbol: \"doz\", factor: 12)","","let carton = Quantity(value: 2, unit: dozenEggs)","print(carton.converted(to: egg).value) \/\/ 24","","let pricePerEgg = Quantity(value: 0.25, unit: Units.usd.per(egg))","print((pricePerEgg * carton).formatted()) \/\/ $6.00"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Eggs and apples are both dimensionless, but they do not convert to each other.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CountingUnits","isActive":true},{"text":" for the full guide.","type":"text"}]},{"anchor":"Mass-versus-weight","type":"heading","level":3,"text":"Mass versus weight"},{"type":"paragraph","inlineContent":[{"text":"Mass and weight are different things, and the namespaces make the distinction","type":"text"},{"text":" ","type":"text"},{"text":"explicit so the two can never be mixed up.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass","isActive":true},{"type":"text","text":" contains the mass units — "},{"type":"codeVoice","code":"Units.Mass.ounce"},{"type":"text","text":" is the ounce of"},{"type":"text","text":" "},{"type":"text","text":"mass (symbol "},{"type":"codeVoice","code":"oz"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Weight","isActive":true},{"type":"text","text":" contains the force units, the physics-correct meaning of"},{"type":"text","text":" "},{"type":"text","text":"“weight” — "},{"type":"codeVoice","code":"Units.Weight.ounce"},{"type":"text","text":" is the ounce-force (symbol "},{"type":"codeVoice","code":"ozf"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Units.Weight.pound"},{"type":"text","text":" is the pound-force (symbol "},{"type":"codeVoice","code":"lbf"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Every avoirdupois mass unit has a matching weight (force) reading in","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Weight","isActive":true},{"text":": ","type":"text"},{"type":"codeVoice","code":"gram"},{"text":", ","type":"text"},{"type":"codeVoice","code":"grain"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ounce"},{"text":", ","type":"text"},{"type":"codeVoice","code":"pound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dram"},{"text":", ","type":"text"},{"type":"codeVoice","code":"stone"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"shortTon"},{"text":", ","type":"text"},{"type":"codeVoice","code":"longTon"},{"text":", ","type":"text"},{"type":"codeVoice","code":"hundredweight"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"longHundredweight"},{"text":" there are all","type":"text"},{"text":" ","type":"text"},{"text":"force units (","type":"text"},{"type":"codeVoice","code":"gf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"grf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ozf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"lbf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dramf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"stf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"stnf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ltnf"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"cwtf"},{"text":", ","type":"text"},{"type":"codeVoice","code":"lcwtf"},{"text":"), each equal to the standard-gravity weight of its mass","type":"text"},{"text":" ","type":"text"},{"text":"counterpart — ","type":"text"},{"type":"codeVoice","code":"W = mg"},{"text":". The troy and jewelry systems get the same treatment:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"troyOunce"},{"text":", ","type":"text"},{"type":"codeVoice","code":"troyPound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"troyDram"},{"text":", ","type":"text"},{"type":"codeVoice","code":"pennyweight"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"carat"},{"text":" also resolve","type":"text"},{"text":" ","type":"text"},{"text":"as forces (","type":"text"},{"code":"ozf_t","type":"codeVoice"},{"type":"text","text":", "},{"code":"lbf_t","type":"codeVoice"},{"text":", ","type":"text"},{"code":"drf_t","type":"codeVoice"},{"type":"text","text":", "},{"code":"dwtf","type":"codeVoice"},{"type":"text","text":", "},{"code":"ctf","type":"codeVoice"},{"type":"text","text":"). The mass readings"},{"text":" ","type":"text"},{"text":"themselves stay in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass","isActive":true,"type":"reference"},{"text":", where ","type":"text"},{"code":"slug","type":"codeVoice"},{"text":" is the canonical imperial unit","type":"text"},{"text":" ","type":"text"},{"text":"of mass (1 slug ≈ 32.17 lbm).","type":"text"}]},{"code":["let force = Quantity(value: 1, unit: .weight.stone) \/\/ 1 stf = 14 lbf","let mass  = Quantity(value: 1, unit: .mass.stone)   \/\/ 1 st  = 14 lbm","let gramF = Quantity(value: 1, unit: .weight.gram)  \/\/ 1 gf   = 9.80665 mN","let troyF = Quantity(value: 1, unit: .weight.pennyweight) \/\/ 1 dwtf"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Some words mean different physical things in different contexts. Beyond","type":"text"},{"text":" ","type":"text"},{"code":"ounce","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"pound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dram","type":"codeVoice"},{"type":"text","text":" is available as a mass unit ("},{"code":"Units.Mass.dram","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"a weight\/force unit ("},{"type":"codeVoice","code":"Units.Weight.dram"},{"type":"text","text":", the dram-force), and a volume unit"},{"text":" ","type":"text"},{"type":"text","text":"("},{"code":"Units.Volume.dram","type":"codeVoice"},{"type":"text","text":", the US fluid dram, one eighth of a US fluid ounce)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because they live in different namespaces, the compiler keeps the two apart:"}]},{"code":["let flour = Quantity(16, Units.Mass.ounce)   \/\/ 16 oz of mass","let force = Quantity(16, Units.Weight.ounce) \/\/ 16 ozf of force","let sack = Quantity(2, Units.Mass.dram)      \/\/ 2 dr of mass","let pull = Quantity(2, Units.Weight.dram)    \/\/ 2 dram-force","let dose = Quantity(2, Units.Volume.dram)    \/\/ 2 fl dr of volume"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"For code that has to be unambiguous, the mass readings also come with explicit","type":"text"},{"text":" ","type":"text"},{"text":"names: ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/poundMass","isActive":true,"type":"reference"},{"text":" (symbol ","type":"text"},{"code":"lbm","type":"codeVoice"},{"text":") and ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/ounceMass","isActive":true,"type":"reference"},{"text":" (symbol","type":"text"},{"text":" ","type":"text"},{"code":"ozm","type":"codeVoice"},{"text":") spell out that they are masses, never forces.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Multiplying a mass by an acceleration already produces a force — both operand","type":"text"},{"type":"text","text":" "},{"type":"text","text":"orders work, so "},{"type":"codeVoice","code":"mass × earth's gravity"},{"type":"text","text":" and "},{"type":"codeVoice","code":"earth's gravity × mass"},{"text":" give a","type":"text"},{"text":" ","type":"text"},{"text":"force quantity. The picker then restates it in whatever force unit reads","type":"text"},{"type":"text","text":" "},{"text":"clearest.","type":"text"}]},{"code":["let mass = Quantity(value: 1, unit: .kilogram)","let weight = mass * Quantity(value: 1, unit: .gravity) \/\/ force quantity","print(weight.simplified())  \/\/ 1 kgf — the cleanest reading"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mathematics in "},{"type":"codeVoice","code":"Math"},{"type":"text","text":" lets you request the most readable unit for a result"},{"type":"text","text":" "},{"type":"text","text":"directly with "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/simplified()-40uns","isActive":true,"type":"reference"},{"text":", which scans the dimension’s catalog","type":"text"},{"type":"text","text":" "},{"text":"(including the SI-prefixed metric siblings) and picks the reading that is a","type":"text"},{"text":" ","type":"text"},{"text":"whole number (smallest positive whole for a positive amount), falling back to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the reading with the fewest decimal places."}]},{"code":["let rope = Quantity(value: 1000, unit: .meter)","print(rope.simplified())     \/\/ 1 km","","let thrust = Quantity(value: 2000, unit: .newton)","print(thrust.simplified())   \/\/ 2 kN","","let ride = Quantity(value: 3600, unit: .second)","print(ride.simplified())     \/\/ 1 hour"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Computing weight from mass","level":3,"anchor":"Computing-weight-from-mass"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Weight is a force, "},{"code":"W = mg","type":"codeVoice"},{"type":"text","text":". Any mass quantity exposes that via"},{"type":"text","text":" "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/weight","type":"reference","isActive":true},{"type":"text","text":", which converts a mass to its weight at standard gravity"},{"type":"text","text":" "},{"type":"text","text":"and returns a force quantity:"}]},{"type":"codeListing","syntax":"swift","code":["let person = Quantity(value: 150, unit: Units.pound) \/\/ 150 lbm","print(person.weight.converted(to: Units.poundForce).value) \/\/ ≈ 150.0 lbf"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"Quantity\/weight(on:)","type":"codeVoice"},{"text":" for another gravitational field and","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/weight(in:)"},{"type":"text","text":" to request a particular force unit:"}]},{"type":"codeListing","syntax":"swift","code":["let probe = Quantity(value: 100, unit: Units.kilogram)","print(probe.weight(on: 1.62).converted(to: Units.newton).value) \/\/ ≈ 162 N on the Moon"]},{"text":"Leading-dot lookup","anchor":"Leading-dot-lookup","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Inside a ","type":"text"},{"type":"codeVoice","code":"Quantity"},{"text":" initializer — whose ","type":"text"},{"type":"codeVoice","code":"unit:"},{"type":"text","text":" parameter is a generic"},{"text":" ","type":"text"},{"type":"codeVoice","code":"U: MathUnit"},{"text":" — the dimensions are available as leading-dot namespaces:","type":"text"}]},{"code":["let oil = Quantity(value: 10, unit: .volume.fluidOunce)","let punch = Quantity(value: 2, unit: .volume.liter).converted(to: .volume.cup)","let force = Quantity(value: 150, unit: .weight.pound)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The first member (","type":"text"},{"type":"codeVoice","code":".volume"},{"text":", ","type":"text"},{"type":"codeVoice","code":".mass"},{"text":", ","type":"text"},{"type":"codeVoice","code":".weight"},{"text":", …) resolves to that","type":"text"},{"text":" ","type":"text"},{"text":"dimension’s namespace, and the second member chains onto any of its units —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"base or prefixed. The mass-versus-weight rule still applies: "},{"type":"codeVoice","code":".mass.pound"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"mass unit and "},{"type":"codeVoice","code":".weight.pound"},{"text":" is a force unit.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let precise = Quantity(value: 1, unit: .voltage.nanovolt) \/\/ nV","let sticky  = Quantity(value: 500, unit: .volume.milliliter)","let disk    = Quantity(value: 1, unit: .data.gibibyte)    \/\/ GiB"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every unit is also available bare, without the dimension name: "},{"type":"codeVoice","code":".nanovolt"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"type":
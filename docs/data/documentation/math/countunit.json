ity(value: 0.25, unit: Units.usd.per(egg))","let total = pricePerEgg * carton            \/\/ $6.00"],"syntax":"swift","type":"codeListing"},{"text":"Identity and families","anchor":"Identity-and-families","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"item"},{"type":"text","text":" is the unit’s family. Two count units with the same item convert"},{"type":"text","text":" "},{"type":"text","text":"freely, even when their scales differ ("},{"type":"codeVoice","code":"egg"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dozenEggs"},{"type":"text","text":"). Two count"},{"type":"text","text":" "},{"type":"text","text":"units with different items do "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" convert: eggs and apples are both"},{"type":"text","text":" "},{"type":"text","text":"dimensionless, but they are not interchangeable."}],"type":"paragraph"},{"code":["let apple = CountUnit(item: \"apple\")","","egg.isCompatible(with: dozenEggs) \/\/ true","egg.isCompatible(with: apple)     \/\/ false"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A count unit created without an item is a "},{"inlineContent":[{"type":"text","text":"generic"}],"type":"emphasis"},{"type":"text","text":" count ("},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Count","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"contains common ones such as "},{"type":"codeVoice","code":"each"},{"type":"text","text":", "},{"type":"codeVoice","code":"pair"},{"type":"text","text":", "},{"type":"codeVoice","code":"dozen"},{"type":"text","text":", and "},{"type":"codeVoice","code":"gross"},{"type":"text","text":"). Generic"},{"type":"text","text":" "},{"type":"text","text":"counts act as a wildcard and interoperate with identified counts, which is"},{"type":"text","text":" "},{"type":"text","text":"handy for shared counting